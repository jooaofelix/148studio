// Deploy do 148 Estúdio no Cloudflare (a cada push no main).
// O worker.js roda antes de qualquer arquivo e só deixa entrar com a senha do segredo SENHA.
{
  "name": "148studio",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
